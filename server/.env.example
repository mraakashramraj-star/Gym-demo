PORT=5000
NODE_ENV=development

# Gym Identity Override (Optional - defaults to "[GYM NAME]")
GYM_NAME="[GYM NAME]"

# JWT Security
JWT_SECRET=gym-super-secret-jwt-key-change-in-prod-2026

# Database (Optional - leaving empty automatically uses persistent local store mode)
MONGODB_URI=mongodb://localhost:27017/gym_platform

# Razorpay Integration (Optional - test sandbox works automatically if empty)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
